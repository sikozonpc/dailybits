<Layouts.app flash={@flash}>
  <header class="mb-10">
    <div class="mb-5" aria-hidden="true">
      <%= if @book.cover != "" do %>
        <img
          src={@book.cover}
          alt=""
          class="h-20 w-14 rounded object-cover ring-1 ring-base-300"
          loading="lazy"
        />
      <% else %>
        <div class="flex h-20 w-14 items-center justify-center rounded bg-base-200 text-2xl">
          📖
        </div>
      <% end %>
    </div>
    <h1 class="text-[40px] font-bold leading-[1.2] tracking-tight">{@book.title}</h1>
    <p class="mt-3 text-[15px] text-base-content/60">{@book.author}</p>
  </header>

  <dl class="mb-12 grid grid-cols-[120px_1fr] gap-y-2 border-y border-base-200 py-4 text-[14px]">
    <dt class="flex items-center gap-2 text-base-content/50">
      <.icon name="hero-user-micro" class="size-3.5" /> Author
    </dt>
    <dd class="text-base-content/80">{@book.author}</dd>

    <dt class="flex items-center gap-2 text-base-content/50">
      <.icon name="hero-hashtag-micro" class="size-3.5" /> ASIN
    </dt>
    <dd>
      <code class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-[12px] text-base-content/80">
        {@book.asin}
      </code>
    </dd>

    <dt class="flex items-center gap-2 text-base-content/50">
      <.icon name="hero-bookmark-micro" class="size-3.5" /> Highlights
    </dt>
    <dd class="text-base-content/80">{length(@book.highlights)}</dd>
  </dl>

  <%= if @book.highlights == [] do %>
    <div class="flex gap-3 rounded-md border border-base-300 bg-base-200/40 px-4 py-4 text-[15px]">
      <span aria-hidden="true" class="text-xl leading-none">📭</span>
      <p class="text-base-content/70">No highlights for this book yet.</p>
    </div>
  <% else %>
    <ul id="highlights-list" class="space-y-8">
      <%= for h <- @book.highlights do %>
        <li>
          <div class="flex items-start gap-2 sm:gap-3">
            <blockquote
              class="min-w-0 flex-1 border-l-[3px] pl-4 text-[16px] leading-[1.7] text-base-content"
              style={"border-color: #{highlight_color(h.color)}"}
            >
              {h.text}
            </blockquote>
            <.metadata_tooltip highlight={h} />
          </div>

          <%= if h.note != "" do %>
            <div
              class="mt-3 flex gap-3 rounded-md px-4 py-3 text-[14px] leading-[1.6]"
              style={"background-color: #{highlight_bg(h.color)}"}
            >
              <span aria-hidden="true" class="shrink-0 text-base leading-[1.2]">💡</span>
              <p class="text-base-content/80">{h.note}</p>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</Layouts.app>
