<Layouts.app flash={@flash}>
  <div class="space-y-6">
    <div>
      <.link navigate={~p"/"} class="text-sm font-medium text-primary hover:underline">
        ← Library
      </.link>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight">{@book.title}</h1>
      <p class="mt-1 text-sm text-base-content/70">{@book.author}</p>
      <p class="mt-1 text-xs text-base-content/50">ASIN {@book.asin}</p>
    </div>

    <div class="flex gap-4 rounded-box border border-base-300 bg-base-100 p-4">
      <%= if @book.cover != "" do %>
        <img
          src={@book.cover}
          alt=""
          class="h-32 w-24 shrink-0 rounded object-cover ring-1 ring-base-300"
          loading="lazy"
        />
      <% else %>
        <div class="flex h-32 w-24 shrink-0 items-center justify-center rounded bg-base-300 text-sm text-base-content/50">
          No cover
        </div>
      <% end %>
      <div class="min-w-0 flex-1 text-sm text-base-content/70">
        <p>Highlights below are ordered by most recently accessed.</p>
      </div>
    </div>

    <%= if @book.highlights == [] do %>
      <p class="rounded-box border border-base-300 bg-base-200/50 px-4 py-8 text-center text-sm text-base-content/70">
        No highlights for this book yet.
      </p>
    <% else %>
      <ul class="space-y-3" id="highlights-list">
        <%= for h <- @book.highlights do %>
          <li class="rounded-lg border border-base-300 bg-base-200/40 px-3 py-3">
            <p class="text-sm leading-relaxed">{h.text}</p>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/60">
              <span class="inline-flex items-center gap-1">
                <span
                  class="size-2 rounded-full ring-1 ring-base-content/20"
                  style={"background-color: #{highlight_color(h.color)}"}
                />
                {h.color}
              </span>
              <span>Loc. {h.location}</span>
              <span title={Calendar.strftime(h.last_accessed, "%Y-%m-%d %H:%M:%S UTC")}>
                {Calendar.strftime(h.last_accessed, "%b %d, %Y")}
              </span>
            </div>
            <%= if h.note != "" do %>
              <p class="mt-2 border-t border-base-300 pt-2 text-sm italic text-base-content/80">
                Note: {h.note}
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</Layouts.app>
