<Layouts.app flash={@flash}>
  <header class="mb-8">
    <div class="mb-4 text-5xl leading-none" aria-hidden="true">📚</div>
    <h1 class="text-[40px] font-bold leading-[1.2] tracking-tight">Library</h1>
    <p class="mt-3 text-[15px] text-base-content/50">
      Books synced from your Kindle. Open one to read its highlights.
    </p>
  </header>

  <%= if @books == [] do %>
    <div class="flex gap-3 rounded-md border border-base-300 bg-base-200/40 px-4 py-4 text-[15px]">
      <span aria-hidden="true" class="text-xl leading-none">🗂️</span>
      <p class="text-base-content/70">
        No books yet. POST to
        <code
          phx-no-curly-interpolation
          class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-[13px] text-base-content/80"
        >
          /api/highlights/sync
        </code>
        to import.
      </p>
    </div>
  <% else %>
    <div class="mb-3 flex items-center justify-between text-[13px] text-base-content/50">
      <span>{length(@books)} {if length(@books) == 1, do: "book", else: "books"}</span>
    </div>

    <ul
      id="books-list"
      class="divide-y divide-base-200 overflow-hidden rounded-md border border-base-200"
    >
      <%= for book <- @books do %>
        <li>
          <.link
            id={"book-#{book.id}"}
            navigate={~p"/books/#{book.id}"}
            class="flex items-center gap-4 px-3 py-2.5 transition hover:bg-base-200/60"
          >
            <div class="shrink-0">
              <%= if book.cover != "" do %>
                <img
                  src={book.cover}
                  alt=""
                  class="h-10 w-7 rounded-sm object-cover ring-1 ring-base-300"
                  loading="lazy"
                />
              <% else %>
                <div class="flex h-10 w-7 items-center justify-center rounded-sm bg-base-200 text-base-content/40">
                  <span aria-hidden="true" class="text-sm">📖</span>
                </div>
              <% end %>
            </div>

            <div class="min-w-0 flex-1">
              <p class="truncate text-[15px] font-medium leading-snug text-base-content">
                {book.title}
              </p>
              <p class="mt-0.5 truncate text-[13px] text-base-content/60">
                {book.author}
              </p>
            </div>

            <div class="hidden shrink-0 items-center gap-2 sm:flex">
              <span class="inline-flex items-center gap-1 rounded bg-base-200 px-2 py-0.5 text-[12px] font-medium text-base-content/70">
                {length(book.highlights)}
                <span class="text-base-content/50">
                  {if length(book.highlights) == 1, do: "highlight", else: "highlights"}
                </span>
              </span>
            </div>

            <.icon
              name="hero-chevron-right"
              class="size-4 shrink-0 text-base-content/30 transition group-hover:text-base-content/60"
            />
          </.link>
        </li>
      <% end %>
    </ul>
  <% end %>
</Layouts.app>
