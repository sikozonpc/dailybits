<Layouts.app flash={@flash} active_tab={@active_tab}>
  <header class="mb-8">
    <div class="mb-4 text-5xl leading-none" aria-hidden="true">🗃️</div>
    <h1 class="text-[40px] font-bold leading-[1.2] tracking-tight">Objects</h1>
    <p class="mt-3 text-[15px] text-base-content/50">
      Content captured from the web via the browser extension.
    </p>
  </header>

  <%= if @objects == [] do %>
    <div class="flex gap-3 rounded-md border border-base-300 bg-base-200/40 px-4 py-4 text-[15px]">
      <span aria-hidden="true" class="text-xl leading-none">📭</span>
      <p class="text-base-content/70">
        No objects yet. Use the browser extension to capture content.
      </p>
    </div>
  <% else %>
    <div class="mb-3 flex items-center justify-between text-[13px] text-base-content/50">
      <span>{length(@objects)} {if length(@objects) == 1, do: "object", else: "objects"}</span>
    </div>

    <ul
      id="objects-list"
      class="divide-y divide-base-200 overflow-hidden rounded-md border border-base-200"
    >
      <%= for object <- @objects do %>
        <li class="flex items-start gap-3 px-4 py-3">
          <span class="mt-0.5 shrink-0 rounded bg-base-200 px-1.5 py-0.5 font-mono text-[11px] text-base-content/60 uppercase">
            {object.type}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-[15px] font-medium leading-snug text-base-content">
              {object.title}
            </p>
            <p class="mt-1 line-clamp-2 text-[13px] text-base-content/60 break-all">
              {object.content}
            </p>
            <a href={object.url} target="_blank" rel="noopener noreferrer" class="text-blue-200 underline mt-1 line-clamp-2 text-[13px] text-base-content/60 break-all">
              {object.url}
            </a>
          </div>
          <span class="shrink-0 text-[12px] text-base-content/40">
            {Calendar.strftime(object.inserted_at, "%b %d, %Y")}
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</Layouts.app>
